# Host-side ports for the dev Docker stack, all bound to loopback. Container-
# internal ports stay standard; only the host-side mapping is configurable so
# the stack can coexist with other projects already sitting on the defaults.
#
# Sourced by the Makefile (`set -a; source ports.env; set +a`) before compose.

export WHILEYOUWAIT_PG_PORT="5432"

# App services (`make up`, the "app" compose profile).
export WHILEYOUWAIT_WEB_PORT="8080"
export WHILEYOUWAIT_UMAMI_PORT="3901"
