# Rendered by the nginx image's envsubst step at container start, so
# ${UMAMI_WEBSITE_ID} and ${UMAMI_HOST} below are filled from the environment. Only variables that
# exist in the environment are substituted; nginx's own $variables are left alone.
# JSON access log, so the log pipeline (infra: Alloy -> Loki) parses fields
# instead of a combined-format line.
log_format json escape=json '{"time":"$time_iso8601","remote_addr":"$remote_addr",'
    '"forwarded_for":"$http_x_forwarded_for","method":"$request_method",'
    '"uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,'
    '"referer":"$http_referer","user_agent":"$http_user_agent",'
    '"request_time":$request_time}';

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/access.log json;
    root /usr/share/nginx/html;

    # Redirects stay relative: behind Traefik nginx does not know the public host.
    absolute_redirect off;

    gzip on;
    gzip_types text/html application/javascript text/css;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location = /shared/config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        return 200 'window.WYW_SITE = "${UMAMI_WEBSITE_ID}";\nwindow.WYW_UMAMI = "${UMAMI_HOST}";\n';
    }

    error_page 404 /404.html;

    # nginx's mime.types has no entry for the web app manifest.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Social cards and icons change only with a deploy; a day of caching is plenty.
    location ~ ^/(og/|favicon\.svg$|apple-touch-icon\.png$) {
        add_header Cache-Control "public, max-age=86400";
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}
